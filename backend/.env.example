PORT=5000
NODE_ENV=development
# Primary MongoDB Atlas Connection string or local fallback
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/shopnest
JWT_SECRET=replace-with-a-long-random-secret

# Razorpay (https://dashboard.razorpay.com/app/keys) - use rzp_test_ keys while developing
RAZORPAY_KEY_ID=replace-with-your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-key-secret
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
